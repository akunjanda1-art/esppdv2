# Global
ENV=development
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=esppd
POSTGRES_USER=esppd
POSTGRES_PASSWORD=esppd_password
POSTGRES_SSLMODE=disable

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# NATS JetStream
NATS_URL=nats://nats:4222
NATS_STREAM=esppd

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=esppd-docs
MINIO_USE_SSL=false

# JWT
JWT_ISSUER=esppd
JWT_AUDIENCE=esppd-users
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_PRIVATE_KEY=/secrets/jwt_private.pem
JWT_PUBLIC_KEY=/secrets/jwt_public.pem
JWT_PRIVATE_KEY_PASSPHRASE=devkey

# Auth (LDAP)
# Modes: disabled | prefer | required
AUTH_LDAP_MODE=disabled
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=(uid={username})
LDAP_STARTTLS=false
LDAP_INSECURE_SKIP_VERIFY=false
LDAP_TIMEOUT=5s

# Encryption (32 bytes base64 for AES-256-GCM)
DATA_ENC_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTES

# Service Ports
AUTH_SERVICE_PORT=8001
SPD_SERVICE_PORT=8002
APPROVAL_SERVICE_PORT=8003
DOCUMENT_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8005
REPORTING_SERVICE_PORT=8006
BUDGET_SERVICE_PORT=8007
AUDIT_SERVICE_PORT=8008

# Rate limit
RATE_LIMIT_PER_MIN=120
